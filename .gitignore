*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
Inventory_Images/
.env*.local

# Build artifacts + temporary working dirs
tmp/
workshop-decks.pdf

# RBAC snapshot backups (prod grant dumps — never commit)
rbac-backups/
